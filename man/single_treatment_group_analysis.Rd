\deqn{\delta_{APO}(g) = \mu(g,d,b) + \mu(g,d',a) - \mu(g,d',b), \qquad
  \delta^{\times}_{APO}(g) = \mu(g,d,b)\,\mu(g,d',a) / \mu(g,d',b).}{
  delta_APO(g) = mu(g,d,b) + mu(g,d',a) - mu(g,d',b),
